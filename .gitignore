# Dependencies
node_modules/
.pnp
.pnp.js

# The vendored skill directory (BOOT.md Section A) installs its own deps.
# .opencode/.gitignore covers these too; repeated here so a nested
# node_modules can never leak into test collection (ERR-003) if that
# file is removed.
.opencode/node_modules/

# Build output
dist/
build/
.vite/
.turbo/
*.tsbuildinfo

# Data — fetched by script, never committed (see ERROR_LOG pre-flight log)
public/data/*
!public/data/.gitkeep

# Environment
.env
.env.local
.env.*.local
!.env.example

# Test output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Editor
.DS_Store
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
Thumbs.db

# Vercel / deploy
.vercel/
